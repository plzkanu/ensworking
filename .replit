run = "npm run dev"
entrypoint = "package.json"
hidden = [".config", ".next", "node_modules"]

modules = ["nodejs-22"]

[nix]
channel = "stable-24_11"

[deployment]
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]
deploymentTarget = "cloudrun"

# Cloud Run 배포 시 PORT 가 동적으로 지정됩니다. scripts/start.mjs 가 PORT 를 사용합니다.
# 워크스페이스 Preview 는 아래 3000 포트 매핑을 사용합니다.
[[ports]]
localPort = 3000
externalPort = 80
